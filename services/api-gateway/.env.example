# MTF Trading System - Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://lab:lab1234@localhost:5432/mtf_trading
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab1234
POSTGRES_DB=mtf_trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# Vector Database (Qdrant)
# ============================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optional, leave empty for local development

# ============================================
# Risk Guardrails (F2.2, F2.3, F2.4)
# ============================================
# These values override the database risk_rules table when set
# Primary use: Testing different risk profiles
MAX_RISK_PER_TRADE=10.00
MIN_LOT_SIZE=0.01
MAX_ATR_PIPS_SL=100.0
MIN_RR_RATIO=2.0

# ============================================
# Google Cloud / Vertex AI (Future)
# ============================================
# GEMINI_API_KEY=your_gemini_api_key_here
# GCP_PROJECT_ID=line-bot-2b383
# GCP_REGION=us-central1

# ============================================
# Market Data APIs
# ============================================
# ALPACA_API_KEY=your_alpaca_key_here
# ALPACA_SECRET_KEY=your_alpaca_secret_here
# OANDA_API_KEY=your_oanda_key_here
# OANDA_ACCOUNT_ID=your_oanda_account_id_here
# BINANCE_ACCOUNT_ID=
# BINANCE_API_KEY=
# BINANCE_SECRET_KEY=


# ============================================
# Application Configuration
# ============================================
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# ============================================
# FastAPI Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
RELOAD=true  # Auto-reload on code changes (dev only)
SECRET_KEY=YOUR_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

STRATEGY_CORE_URL=http://strategy-core:8000
EXECUTION_SERVICE_URL=http://execution:8000
SETTINGS_ENCRYPTION_KEY=YOUR_SETTINGS_ENCRYPTION_KEY