# Database Configuration
POSTGRES_USER=trader
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=mtf_db
POSTGRES_HOST=mtf-postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trader:your_db_password@mtf-postgres:5432/mtf_db

# AI & Analysis
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL_ID=gemini-2.5-flash
# https://newsapi.org/
NEWS_API_KEY=your_news_api_key

# Vector Database
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=your_qdrant_api_key

# Market Data APIs
OANDA_API_KEY=your_oanda_api_key
OANDA_ACCOUNT_ID=your_oanda_account_id
OANDA_ENV=practice

BINANCE_ACCOUNT_ID=your_binance_account_id
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key

CTRADER_CLIENT_ID=your_ctrader_client_id
CTRADER_CLIENT_SECRET=your_ctrader_client_secret
CTRADER_ACCOUNT_ID=your_ctrader_account_id
CTRADER_TOKEN=your_ctrader_token
CTRADER_REFRESH_TOKEN=your_ctrader_refresh_token

# Risk Guardrails
MIN_LOT_SIZE=0.01
MAX_RISK_PER_TRADE=10.00
MAX_ATR_PIPS_SL=100.0
MIN_RR_RATIO=1.5

# Security & Services
SECRET_KEY=your_secret_key_for_jwt
ACCESS_TOKEN_EXPIRE_MINUTES=43200
SETTINGS_ENCRYPTION_KEY=your_encryption_key_for_secrets

# Service URLs
STRATEGY_CORE_URL=http://strategy-core:8000
EXECUTION_SERVICE_URL=http://execution:8000
DATA_PIPELINE_URL=http://data-pipeline:8000
REDIS_URL=redis://redis:6379/0
AI_ANALYST_URL=http://ai-analyst:8000

# App State
LIVE_TRADING_ENABLED=False
OPERATIONAL_MODE=SHADOW
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
RELOAD=true

# Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret


# Google Search Engine Results API with SerpApi
SERPAPI_API_KEY=your_serpapi_api_key